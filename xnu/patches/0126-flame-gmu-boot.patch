+/*
+ * A640 firmware (mainline a6xx_gmu_fw_load, non-legacy): blocks of {addr, size, type, value}
+ * then size bytes. ITCM at GMU address 0, DTCM at 0x40000 (16 KiB each); other blocks go to
+ * the icache/dcache/dummy backing in GPU-GMU-MEM by their GMU address (gmu_regions). TCM
+ * writes are read back; a block that fits nowhere stops the load.
+ */
+static bool
+gmu_fw_blocks(const uint8_t *fw, uint32_t len)
+{
+	unsigned nblk = 0, tcm_words = 0, mem_words = 0, bad = 0;
+	uint32_t off = 0;
+	while (off + 16u <= len) {
+		uint32_t addr = fw32(fw + off), size = fw32(fw + off + 4u);
+		const uint8_t *data = fw + off + 16u;
+		if (size > len - off - 16u || (size & 3u)) {
+			printf("SWEET GMU:   block %u at file +%#x: size %#x runs past the file\n", nblk, off, size);
+			return false;
+		}
+		const char *where = "NOWHERE";
+		if (size == 0) {
+			where = "empty";
+		} else if (addr + size <= 0x4000u) {
+			for (uint32_t i = 0; i < size / 4u; ++i) {
+				uint32_t reg = REG_A6XX_GMU_CM3_ITCM_START + addr / 4u + i;
+				gmu_wr(gm_gmu, reg, fw32(data + 4u * i));
+				bad += gmu_rd(gm_gmu, reg) != fw32(data + 4u * i);
+			}
+			tcm_words += size / 4u;
+			where = "ITCM";
+		} else if (addr >= 0x40000u && addr + size <= 0x44000u) {
+			for (uint32_t i = 0; i < size / 4u; ++i) {
+				uint32_t reg = REG_A6XX_GMU_CM3_DTCM_START + (addr - 0x40000u) / 4u + i;
+				gmu_wr(gm_gmu, reg, fw32(data + 4u * i));
+				bad += gmu_rd(gm_gmu, reg) != fw32(data + 4u * i);
+			}
+			tcm_words += size / 4u;
+			where = "DTCM";
+		} else {
+			for (unsigned r = 0; r < sizeof(gmu_regions) / sizeof(gmu_regions[0]); ++r) {
+				if (addr >= gmu_regions[r].iova && addr + size <= gmu_regions[r].iova + gmu_regions[r].len) {
+					uint32_t m = gmu_regions[r].off + (addr - gmu_regions[r].iova);
+					for (uint32_t i = 0; i < size / 4u; ++i) {
+						mem_wr(m + 4u * i, fw32(data + 4u * i));
+					}
+					mem_words += size / 4u;
+					where = gmu_regions[r].name;
+					break;
+				}
+			}
+		}
+		printf("SWEET GMU:   block %u: addr %#010x size %#06x -> %s\n", nblk, addr, size, where);
+		if (where[0] == 'N') {
+			return false;
+		}
+		off += 16u + size;
+		++nblk;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	printf("SWEET GMU:   %u blocks, %u TCM words (%u differ on read-back), %u backing words, %u of %u file bytes\n",
+	    nblk, tcm_words, bad, mem_words, off, len);
+	return bad == 0 && off == len && nblk > 0;
 }
 

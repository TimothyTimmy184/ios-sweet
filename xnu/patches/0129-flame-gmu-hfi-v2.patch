+/* flame 2B.5: mainline a6xx_hfi_start for non-legacy GMUs. */
+static bool
+gmu_hfi_v2(void)
+{
+	printf("SWEET GMU: 2B.5 HFI v2 (A640): start, PERF_TABLE, BW_TABLE, CORE_FW_START, START\n");
+	if (!gm_votes_ok) {
+		printf("SWEET GMU: 2B.5 needs 2B.4\n");
+		return false;
+	}
+	static const char *const bcm[4] = { "MC0", "SH0", "ACV", "CN0" };
+	for (unsigned i = 0; i < 4; ++i) {
+		uint32_t a = 0;
+		if (!gmu_cmddb(bcm[i], CMDDB_BCM, &a, NULL, 0, NULL)) {
+			printf("SWEET GMU:   cmd-db BCM %s at %#x (for comparison with mainline's a640 table)\n", bcm[i], a);
+		}
+	}
+	gpu_pause("HFI start (HFI_CTRL_INIT = 1)");
+	gmu_wr(gm_gmu, REG_A6XX_GMU_HFI_CTRL_INIT, 1);
+	bool ok = gmu_wait(REG_A6XX_GMU_HFI_CTRL_STATUS, 1, 1, GMU_TIMEOUT_US);
+	uint32_t ver = gmu_rd(gm_gmu, REG_A6XX_GMU_HFI_VERSION_INFO);
+	printf("SWEET GMU:   HFI_CTRL_STATUS 0x%08x (%s), HFI_VERSION_INFO 0x%08x (major %u)\n",
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_HFI_CTRL_STATUS), ok ? "up" : "NOT UP in 100 ms", ver, ver >> 28);
+	if (!ok) {
+		printf("SWEET GMU: 2B.5 stopped: HFI did not start\n");
+		return false;
+	}
+
+	gpu_pause("HFI PERF_TABLE v2 (6 GPU levels with acd off, 2 GMU levels)");
+	gmu_msg_clear();
+	gm_msg[1] = FL_GPU_LEVELS;
+	gm_msg[2] = GMU_LEVELS;
+	for (unsigned i = 0; i < FL_GPU_LEVELS; ++i) {
+		gm_msg[3u + 3u * i] = gm_gx_votes[i];
+		gm_msg[4u + 3u * i] = 0xffffffffu;              /* acd: off */
+		gm_msg[5u + 3u * i] = fl_level_khz[i];
+	}
+	for (unsigned i = 0; i < GMU_LEVELS; ++i) {
+		gm_msg[3u + 3u * HFI_MAX_GX_LEVELS + 2u * i] = gm_cx_votes[i];
+		gm_msg[4u + 3u * HFI_MAX_GX_LEVELS + 2u * i] = gmu_level_khz[i];
+	}
+	if (!gmu_hfi_send(H2F_MSG_PERF_TBL, HFI_PERF_V2_DWORDS, "PERF_TABLE", NULL)) {
+		return false;
+	}
+
+	/* a640_build_bw_table: one "off" level; DDR and CNOC command addresses as mainline fixes them. */
+	gpu_pause("HFI BW_TABLE (mainline a640 table: one off level)");
+	gmu_msg_clear();
+	gm_msg[1] = 1;                  /* bw_level_num */
+	gm_msg[2] = 3;                  /* cnoc_cmds_num */
+	gm_msg[3] = 3;                  /* ddr_cmds_num */
+	gm_msg[4] = 1;                  /* cnoc_wait_bitmask */
+	gm_msg[5] = 1;                  /* ddr_wait_bitmask */
+	static const uint32_t cnoc_addr[3] = { 0x50034u, 0x5007cu, 0x5004cu };
+	static const uint32_t cnoc_off[3] = { 0x40000000u, 0x00000000u, 0x40000000u };
+	static const uint32_t cnoc_on[3] = { 0x60000001u, 0x20000001u, 0x60000001u };
+	static const uint32_t ddr_addr[3] = { 0x50000u, 0x5003cu, 0x5000cu };
+	for (unsigned i = 0; i < 3; ++i) {
+		gm_msg[6u + i] = cnoc_addr[i];
+		gm_msg[12u + i] = cnoc_off[i];
+		gm_msg[18u + i] = cnoc_on[i];
+		gm_msg[24u + i] = ddr_addr[i];
+		gm_msg[32u + i] = 0x40000000u;
+	}
+	if (!gmu_hfi_send(H2F_MSG_BW_VOTE_TBL, HFI_MSG_MAX, "BW_TABLE", NULL)) {
+		return false;
+	}
+
+	gpu_pause("HFI CORE_FW_START");
+	gmu_msg_clear();
+	if (!gmu_hfi_send(H2F_MSG_CORE_FW_START, 2, "CORE_FW_START", NULL)) {
+		return false;
+	}
+	gpu_pause("HFI START");
+	gmu_msg_clear();
+	if (!gmu_hfi_send(H2F_MSG_START, 1, "START", NULL)) {
+		return false;
+	}
+	sweet_gmu_status("after HFI v2");
+	printf("SWEET GMU: 2B.5 done: HFI v2 up, all four messages acked\n");
+	return true;
+}

+static void
+usb_step(const char *what)
+{
+	if (!usb_flame) {
+		return;
+	}
+	printf("SWEET USB: next: %s (in %u ms)\n", what, usb_step_ms);
+	ud_sleep_ms(usb_step_ms);
+}

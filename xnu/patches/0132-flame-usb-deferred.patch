+/* True if the apps SMMU lets stream 0x140 through untranslated. Reads only. */
+static bool
+usb_apps_smmu_ok(void)
+{
+	vm_offset_t s = ml_io_map(APPS_SMMU_PA, 0x1000);
+	if (s == 0) {
+		printf("SWEET USB: apps SMMU map failed\n");
+		return false;
+	}
+	uint32_t scr0 = usb_rd(s, 0x000), idr0 = usb_rd(s, 0x020), nsmr = idr0 & 0xffu;
+	printf("SWEET USB: apps SMMU sCR0 0x%08x IDR0 0x%08x (%u stream-match groups)\n", scr0, idr0, nsmr);
+	if (scr0 & 1u) {
+		printf("SWEET USB: apps SMMU client port disabled: every stream bypasses\n");
+		return true;
+	}
+	int hit = -1;
+	for (uint32_t i = 0; i < nsmr && i < 256; i++) {
+		uint32_t smr = usb_rd(s, 0x800 + 4 * i);
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		if ((smr & (1u << 31)) && ((USB_SMMU_SID ^ id) & ~mask) == 0) {
+			uint32_t s2cr = usb_rd(s, 0xc00 + 4 * i);
+			printf("SWEET USB: stream 0x%x matches SMR%u 0x%08x: S2CR 0x%08x (type %u, bank %u)\n",
+			    USB_SMMU_SID, i, smr, s2cr, (s2cr >> 16) & 3u, s2cr & 0xffu);
+			if (hit < 0) {
+				hit = (int)((s2cr >> 16) & 3u);
 			}
 		}
 	}
+	if (hit < 0) {
+		bool fault = (scr0 & (1u << 10)) != 0;
+		printf("SWEET USB: stream 0x%x matches no SMR; unmatched streams %s\n", USB_SMMU_SID,
+		    fault ? "FAULT" : "bypass");
+		return !fault;
+	}
+	if (hit == 1) {
+		return true;
+	}
+	printf("SWEET USB: stream 0x%x is %s by the apps SMMU\n", USB_SMMU_SID, hit == 0 ? "TRANSLATED" : "FAULTED");
+	return false;
 }
 
 static void
+usb_defer_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	printf("SWEET USB: device start in %u s\n", usb_delay_s);
+	ud_sleep_ms(usb_delay_s * 1000u);
+	usb_step("apps SMMU check for the USB stream (reads only)");
+	bool ok = usb_apps_smmu_ok();
+	if (!ok && !usb_force) {
+		printf("SWEET USB: device start stopped: USB DMA would not bypass the apps SMMU (sweetusbforce=1 overrides)\n");
+	} else {
+		sweet_usb_gadget_start(usb_dwc_deferred);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}

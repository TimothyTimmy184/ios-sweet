+/* Pins, then the coral fts.c power-on order; leaves the IC held in reset. */
+static void
+fl_power(void)
+{
+	printf("SWEET FTS: TLMM irq cfg=%#x io=%#x switch cfg=%#x io=%#x reset cfg=%#x io=%#x spi51 cfg=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(FL_PIN_IRQ)), touch_rd(st.gpio, TOUCH_GPIO_IO(FL_PIN_IRQ)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(FL_PIN_SWITCH)), touch_rd(st.gpio, TOUCH_GPIO_IO(FL_PIN_SWITCH)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(FL_PIN_RESET)), touch_rd(st.gpio, TOUCH_GPIO_IO(FL_PIN_RESET)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(51)));
+	touch_gpio(FL_PIN_SWITCH, 0, 0, 0, true, false);    /* AP owns the bus */
+	touch_gpio(FL_PIN_IRQ, 0, 0, 0, false, false);      /* input, 2 mA, bias-disable */
+	for (unsigned p = 51; p <= 54; ++p) {
+		touch_gpio(p, 1, 0, 2, false, false);       /* qup4, 6 mA, bias-disable */
+	}
+	touch_gpio(FL_PIN_RESET, 0, 0, 0, true, false);
+	int vdd = sweet_rpmh_vreg_enable("ldoa14", 1800);
+	touch_wait(1);
+	int avdd = sweet_rpmh_vreg_enable("ldoa17", 2856);
+	touch_wait(15);
+	printf("SWEET FTS: vdd L14 err=%d avdd L17 err=%d\n", vdd, avdd);
 }
 

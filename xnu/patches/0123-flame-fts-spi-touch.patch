+/*
+ * One GENI SPI M command in FIFO mode (flame). Same polling scheme as
+ * touch_msg_run; SPI has no NACK, and the GP IRQ bits are not errors here.
+ * TX at most 4 bytes (one FIFO word); RX at most 90; CS commands carry none.
+ */
+static int
+fl_spi_run(unsigned op, unsigned params, const uint8_t *tx, unsigned nt,
+    uint8_t *rx, unsigned nr)
+{
+	if (st.dead || nt > 4 || nr > 90 || (nt && nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE4 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	if (nt) {
+		touch_wr(st.se, SE_TX_LEN, nt);
+	}
+	if (nr) {
+		touch_wr(st.se, SE_RX_LEN, nr);
+	}
+	touch_wr(st.se, SE_CMD, (op << 27) | params);
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SPI_ERRORS) {
+			err = EIO;
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			st.sent = nt;
+			touch_wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE was sampled before the drain above, so all RX words were in the FIFO. */
+		if (irq & SE_DONE) {
+			irq = touch_irq();
+			if (irq & SPI_ERRORS) {
+				err = EIO;
+				break;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (st.got == nr && st.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+fl_spi(unsigned op, unsigned params, const uint8_t *tx, unsigned nt,
+    uint8_t *rx, unsigned nr)
+{
+	st.irq_status = st.irq_last = 0;
+	st.sent = st.got = 0;
+	int err = fl_spi_run(op, params, tx, nt, rx, nr);
+	if (st.probing) {
+		printf("SWEET FTS: spi op=%u len=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    op, nr ? nr : nt, err, st.irq_last, st.irq_status, st.sent, st.got,
+		    touch_rd(st.se, SE_STATUS));
+	}
+	return err;
+}

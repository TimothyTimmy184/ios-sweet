+ * Pixel 4 (flame, boot-arg sweetfts=2): the same FTM5 family on SPI.
+ * DT spi@890000 = QUPv3 wrapper 0 SE4 (TLMM 51-54, function qup4, 6 mA),
+ * touchscreen@0 = CS0, SPI mode 0, max 10 MHz. Google's coral fts_touch SPI
+ * build: FIFO read command 0x87 answered after one dummy byte; every message
+ * is CS-framed (CS low, TX, RX, 10 us, CS high). IRQ TLMM 122, reset 127,
+ * bus switch 126 (low = AP owns the bus, high = SLPI). vdd = PM8150 L14
+ * (1.8 V), avdd = PM8150 L17 (2.856 V); power-on order from fts.c: reset low,
+ * vdd, 1 ms, avdd, 5 + 10 ms, reset high. Panel timings give 1080x2280.
+ * All flame TLMM pins used here are in the SOUTH tile.
+ */
+#define FL_SE_PA        0x00890000u
+#define FL_QUP_PA       0x008c0000u     /* qupv3_0_geni_se wrapper (HW version at +4) */
+#define FL_SOUTH_PA     0x03d00000u
+#define FL_SOUTH_SIZE   0x00090000u     /* through GPIO 143 */
+#define FL_GCC_MASK     ((0x0fu << 6) | (1u << 14)) /* wrap0 m/s-ahb, core, core2x; SE4 */
+#define FL_RCG          0x17608u        /* gcc_qupv3_wrap0_s4_clk_src */
+#define FL_PIN_IRQ      122u

+#define SPI_CS_DEASSERT 9u
+#define SPI_FRAG        (1u << 2)
+/* GENI M_IRQ: overrun, illegal, failure, cancel, abort, FIFO rd/wr errors. No GP bits. */
+#define SPI_ERRORS      (0x3eu | (3u << 24) | (3u << 28))

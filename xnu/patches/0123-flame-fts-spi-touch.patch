+/*
+ * Flame SE4 clock: vote wrapper 0 + SE4 on, then find what the RCG runs at.
+ * Without DFS, program XO/1 exactly as touch_clocks() does for sunfish SE7.
+ * With DFS (tables owned by firmware, never altered), use an XO level if one
+ * exists, else level 0. The rate is an upper bound (M/N only divides), so the
+ * SPI divider derived from it can only make SCLK slower than FL_SPI_HZ.
+ */
+static bool
+fl_clocks(void)
+{
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | FL_GCC_MASK);
+	uint32_t dfs = touch_rd(st.gcc, FL_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, FL_RCG + 4u);
+	printf("SWEET FTS: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, FL_RCG), cfg, dfs);
+	st.clk_level = 0;
+	if (dfs & 1u) {
+		cfg = touch_rd(st.gcc, FL_RCG + 0x1cu);
+		for (unsigned l = 0; l < 8; ++l) {
+			uint32_t c = touch_rd(st.gcc, FL_RCG + 0x1cu + 4u * l);
+			if (((c >> 8) & 7u) == 0 && (c & 0x1fu) <= 1u) {
+				st.clk_level = l;
+				cfg = c;
+				break;
+			}
+		}
+	} else {
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, FL_RCG + 4u, cfg);
+		touch_wr(st.gcc, FL_RCG, touch_rd(st.gcc, FL_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, FL_RCG, 1u)) {
+			printf("SWEET FTS: RCG update timeout\n");
+			return false;
+		}
+	}
+	/* gcc_parent_map_0: XO 0, GPLL0 main (600 MHz) 1, GPLL0 even (300 MHz) 6. */
+	unsigned src = (cfg >> 8) & 7u, hid = cfg & 0x1fu;
+	uint64_t hz = src == 0 ? 19200000ull : src == 6 ? 300000000ull : 600000000ull;
+	if (hid) {
+		hz = hz * 2u / (hid + 1u);
+	}
+	st.se_hz = (unsigned)hz;
+	printf("SWEET FTS: se4 clock level=%u cfg=%#x <= %u Hz\n", st.clk_level, cfg, st.se_hz);
+	const uint32_t branches[] = {0x17604, 0x17004, 0x17008};     /* SE4, m-ahb, s-ahb */
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SWEET FTS: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}

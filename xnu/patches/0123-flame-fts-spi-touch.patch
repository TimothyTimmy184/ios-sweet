+/* coral fts_writeReadU8UX(cmd, ..., hasDummyByte=1): CS low, cmd, dummy + data, CS high. */
+static int
+fl_read(uint8_t cmd, uint8_t *buf, unsigned len)
+{
+	uint8_t raw[1 + FTS5_EVENT_LEN * FTS5_BATCH];
+	if (len + 1u > sizeof(raw)) {
+		return EIO;
+	}
+	int err = fl_spi(SPI_CS_ASSERT, 0, NULL, 0, NULL, 0);
+	if (!err) {
+		err = fl_spi(SPI_TX_ONLY, SPI_FRAG, &cmd, 1, NULL, 0);
+	}
+	if (!err) {
+		err = fl_spi(SPI_RX_ONLY, SPI_FRAG, NULL, 0, raw, len + 1u);
+	}
+	delay(10);      /* SPI_DELAY_CS */
+	int cs = st.dead ? EIO : fl_spi(SPI_CS_DEASSERT, 0, NULL, 0, NULL, 0);
+	if (!err) {
+		err = cs;
+	}
+	if (!err) {
+		memcpy(buf, raw + 1, len);
+	}
+	return err;
+}
+
+static int
+fl_write(const uint8_t *tx, unsigned n)
+{
+	int err = fl_spi(SPI_CS_ASSERT, 0, NULL, 0, NULL, 0);
+	if (!err) {
+		err = fl_spi(SPI_TX_ONLY, SPI_FRAG, tx, n, NULL, 0);
+	}
+	delay(10);
+	int cs = st.dead ? EIO : fl_spi(SPI_CS_DEASSERT, 0, NULL, 0, NULL, 0);
+	return err ? err : cs;
+}
+
+/* FTM5 transport: I2C at 0x49 (sunfish) or CS-framed SPI (flame). */
+static int
+fts_fifo(uint8_t *buf, unsigned len)
+{
+	return st.flame ? fl_read(FL_FIFO_READ, buf, len) :
+	       touch_read(FTS5_ADDR, FTS5_FIFO_READ, false, buf, len);
 }
 
 static int
+fts_cmd(const uint8_t *tx, unsigned n)
+{
+	return st.flame ? fl_write(tx, n) : touch_msg(FTS5_ADDR, tx, n, NULL, 0, false);
+}

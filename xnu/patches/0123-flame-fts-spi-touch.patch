+/* SE4 as Linux spi-geni sets it up for FIFO mode: mode 0, CS0, 8-bit words. */
+static bool
+fl_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	uint32_t ver = touch_rd(st.qup, 4);
+	printf("SWEET FTS: se4 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x qup=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908), ver);
+	if (((fw >> 8) & 0xffu) != 1u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET FTS: need loaded SPI firmware with FIFO mode and 32-bit FIFOs\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET FTS: SE4 already busy\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0);
+	touch_wr(st.se, 0xe1c, 0);
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, st.clk_level);
+	/* spi-geni-qcom: QUP v1.0 oversamples by 2. */
+	unsigned os = ((ver >> 28) == 1u && ((ver >> 16) & 0xfffu) == 0) ? 2u : 1u;
+	unsigned div = (st.se_hz + os * FL_SPI_HZ - 1u) / (os * FL_SPI_HZ);
+	st.spi_div = MAX(1u, MIN(div, 4095u));
+	touch_wr(st.se, SE_MCLK, (st.spi_div << 4) | 1u);
+	touch_wr(st.se, 0x22c, 0);              /* SE_SPI_LOOPBACK: normal */
+	touch_wr(st.se, 0x224, 0);              /* CPHA 0 */
+	touch_wr(st.se, 0x230, 0);              /* CPOL 0 */
+	touch_wr(st.se, 0x24c, 0);              /* CS not inverted */
+	touch_wr(st.se, 0x250, 0);              /* CS0 */
+	touch_wr(st.se, 0x25c, touch_rd(st.se, 0x25c) & ~2u);  /* CS by command only */
+	touch_wr(st.se, 0x268, 8u - 4u);        /* word length 8 (MIN_WORD_LEN 4) */
+	touch_wr(st.se, 0x274, 0);              /* pre/post command delay */
+	touch_wr(st.se, 0x278, 0);              /* inter-word, CS-to-clock delay */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("SWEET FTS: spi div=%u os=%u (~%u Hz) word=%#x cfg=%#x packing=%#x/%#x\n",
+	    st.spi_div, os, st.se_hz / (os * st.spi_div), touch_rd(st.se, 0x268),
+	    touch_rd(st.se, 0x25c), touch_rd(st.se, 0x260), touch_rd(st.se, 0x284));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    touch_rd(st.se, 0x254) != 0 || touch_rd(st.se, 0x268) != 4u) {
+		printf("SWEET FTS: SE4 readback mismatch\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET FTS: inherited FIFO data\n");
+		return false;
+	}
+	return true;
+}
